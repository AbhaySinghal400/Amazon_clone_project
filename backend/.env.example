PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/amazon-clone


# JWT Configuration
JWT_SECRET=mySuperSecretAmazonCloneKey123
JWT_EXPIRE=30d

# Nodemailer Configuration (For email verification & password resets)
# You can use a service like Ethereal Email for testing, or Gmail with app password
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@amazonmarketplace.com
FROM_NAME="Amazon Marketplace"

# Razorpay Configuration (For payment processing)
# Set to 'simulator' to bypass actual payment verification for offline/local testing
RAZORPAY_KEY_ID=simulator
RAZORPAY_KEY_SECRET=simulator_secret

# Upload Configuration (Local relative path or absolute)
UPLOAD_PATH=uploads/
